# Public client-side configuration.
# Every VITE_ value is embedded into the built JavaScript and is visible to visitors.

# Optional scheduling link (for example, your own booking page).
VITE_BOOKING_URL=

# Optional form service or API endpoint that accepts a JSON POST request.
VITE_DEMO_FORM_ENDPOINT=

# Optional absolute site URL used for canonical and Open Graph metadata.
# Example: https://your-username.github.io/serviceflow-marketing
VITE_SITE_URL=

# Build-time base path. Must start and end with a slash.
# For a project repository named serviceflow-marketing this is:
# VITE_BASE_PATH=/serviceflow-marketing/
